{
  "name": "cloud-native-nft-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contracts:compile": "pnpm --filter @blockforge/contracts compile",
    "contracts:test": "pnpm --filter @blockforge/contracts test",
    "contracts:node": "pnpm --filter @blockforge/contracts node",
    "contracts:deploy": "pnpm --filter @blockforge/contracts run deploy:local",
    "contracts:seed-local": "pnpm --filter @blockforge/contracts run seed:local",
    "contracts:export-abi": "pnpm --filter @blockforge/contracts export:abi",
    "api:build": "pnpm --filter @blockforge/api build",
    "api:typecheck": "pnpm --filter @blockforge/api typecheck",
    "db:generate": "pnpm --filter @blockforge/database generate",
    "db:migrate": "pnpm --filter @blockforge/database migrate:dev",
    "db:studio": "pnpm --filter @blockforge/database studio",
    "shared:build": "pnpm --filter @blockforge/shared build",
    "shared:typecheck": "pnpm --filter @blockforge/shared typecheck",
    "worker:build": "pnpm --filter @blockforge/worker build",
    "worker:test": "pnpm --filter @blockforge/worker test",
    "worker:typecheck": "pnpm --filter @blockforge/worker typecheck",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis",
    "dev:web": "pnpm --filter @blockforge/web dev",
    "dev:api": "pnpm --filter @blockforge/api start:dev",
    "dev:worker": "pnpm --filter @blockforge/worker dev",
    "web:build": "pnpm --filter @blockforge/web build",
    "web:typecheck": "pnpm --filter @blockforge/web typecheck",
    "web:lint": "pnpm --filter @blockforge/web lint"
  }
}
