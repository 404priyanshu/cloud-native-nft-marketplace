{
  "name": "@blockforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm --filter @blockforge/database build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @blockforge/database build && tsx watch src/main.ts",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "typecheck": "pnpm --filter @blockforge/database build && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@aws-sdk/s3-request-presigner": "^3.1054.0",
    "@blockforge/database": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.0",
    "viem": "^2.51.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
